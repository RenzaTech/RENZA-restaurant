generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  superadmin
  restaurant_admin
  sales_executive
}

enum RestaurantStatus {
  setup
  active
  suspended
}

enum EventType {
  qr_scan
  menu_view
  item_view
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String       @map("password_hash")
  name               String
  role               UserRole     @default(restaurant_admin)
  restaurantId       String?      @map("restaurant_id")
  restaurant         Restaurant?  @relation(fields: [restaurantId], references: [id])
  employeeId         String?      @unique @map("employee_id")
  department         String?      @default("Sales")
  territory          String?
  phone              String?
  createdRestaurants Restaurant[] @relation("SalesAttribution")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@map("users")
}

model Restaurant {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  description           String?
  cuisineType           String?          @map("cuisine_type")
  logoUrl               String?          @map("logo_url")
  address               String?
  city                  String?
  phone                 String?
  status                RestaurantStatus @default(setup)
  customMenuUrl         String?          @map("custom_menu_url")
  googleReviewUrl       String?          @map("google_review_url")
  feedbackUrl           String?          @map("feedback_url")
  superAdminFeedbackUrl String?          @map("super_admin_feedback_url")
  overrideFeedbackUrl   Boolean          @default(false) @map("override_feedback_url")

  // Sales Executive Attribution
  createdById           String?          @map("created_by_id")
  createdBy             User?            @relation("SalesAttribution", fields: [createdById], references: [id])
  salesExecutiveName    String?          @map("sales_executive_name")
  salesExecutiveEmail   String?          @map("sales_executive_email")
  salesExecutiveCode    String?          @map("sales_executive_code")
  salesExecutivePhone   String?          @map("sales_executive_phone")
  salesNotes            String?          @map("sales_notes")
  leadSource            String?          @default("Field Visit") @map("lead_source")
  onboardingSource      String?          @default("SALES_EXECUTIVE") @map("onboarding_source")
  initialTableCount     Int              @default(5) @map("initial_table_count")

  adminUsers            User[]
  categories            Category[]
  foodItems             FoodItem[]
  tables                DiningTable[]
  analytics             AnalyticsEvent[]
  createdAt             DateTime         @default(now()) @map("created_at")

  @@map("restaurants")
}

model DiningTable {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  qrToken      String?    @unique @map("qr_token")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("dining_tables")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0) @map("sort_order")
  foodItems    FoodItem[]
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("categories")
}

model FoodItem {
  id           String           @id @default(cuid())
  restaurantId String           @map("restaurant_id")
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String?          @map("category_id")
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  price        Decimal          @db.Decimal(10, 2)
  portionPrices     String?          @map("portion_prices")
  portionImages     String?          @map("portion_images")
  preparationType   String?          @map("preparation_type")
  preparationPrices String?          @map("preparation_prices")
  imageUrl          String?          @map("image_url")
  topViewImageUrl String?          @map("top_view_image_url")
  isVeg           Boolean          @default(false) @map("is_veg")
  description  String?
  ingredients  String?
  spices       String?
  allergens    String?
  portionSize  String?          @map("portion_size")
  prepTime     String?          @map("prep_time")
  calories     Int?
  isJain       Boolean          @default(false) @map("is_jain")
  isVegan      Boolean          @default(false) @map("is_vegan")
  isGlutenFree Boolean          @default(false) @map("is_gluten_free")
  spicyLevel   Int              @default(0) @map("spicy_level")
  specialTags  String?          @map("special_tags")
  isAvailable  Boolean          @default(true) @map("is_available")
  sortOrder    Int              @default(0) @map("sort_order")
  analytics    AnalyticsEvent[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("food_items")
}

model AnalyticsEvent {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  eventType    EventType  @map("event_type")
  foodItemId   String?    @map("food_item_id")
  foodItem     FoodItem?  @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  sessionId    String     @map("session_id")
  deviceType   String?    @map("device_type")
  ipHash       String?    @map("ip_hash")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("analytics_events")
}
